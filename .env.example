# Copy to .env and adjust. All variables are prefixed with MLOPS_.

# Service metadata
MLOPS_APP_NAME=enterprise-mlops-platform
MLOPS_ENVIRONMENT=dev
MLOPS_LOG_LEVEL=INFO
MLOPS_LOG_JSON=true

# HTTP server
MLOPS_HOST=0.0.0.0
MLOPS_PORT=8000

# Model registry / tracking server
MLOPS_REGISTRY_URI=http://mlflow.mlops.svc.cluster.local:5000
MLOPS_REGISTRY_TIMEOUT_SECONDS=10.0

# Object storage
MLOPS_ARTIFACT_BUCKET=mlops-artifacts
MLOPS_MODEL_BUCKET=mlops-models
MLOPS_AWS_REGION=us-east-1

# Metadata database (do NOT commit real credentials)
MLOPS_METADATA_DB_DSN=postgresql://mlops:changeme@localhost:5432/mlops

# Training backend
MLOPS_TRAINING_NAMESPACE=mlops-training
MLOPS_TRAINING_IMAGE=ghcr.io/abhisheksawant52/mlops-trainer:latest

# Monitoring thresholds
MLOPS_DRIFT_THRESHOLD=0.2
MLOPS_MIN_SERVING_ACCURACY=0.85
